------------------------------------------------
-- SERVICES
------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rs = cloneref(ReplicatedStorage)

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo


------------------------------------------------
-- SETTINGS
------------------------------------------------

local AutoMine = false


------------------------------------------------
-- GET BLOCK INFO
------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


------------------------------------------------
-- BLOCKED BLOCKS
-- THESE WILL NEVER BE MINED
------------------------------------------------

local function isBlocked(info)

    if not info then
        return true
    end

    -- StoneOre
    -- StoneOre1
    -- StoneOre2
    -- StoneOre3
    -- StoneOre4
    -- StoneOre5

    if string.match(info.Id, "^StoneOre%d*$") then
        return true
    end

    -- Bedrock

    if info.Id == "Bedrock" then
        return true
    end

    return false

end


------------------------------------------------
-- MINE ONE ORE
------------------------------------------------

local function mineBlock(block)

    if not block then
        return
    end

    if not block:GetAttribute("isBlock") then
        return
    end

    local info = getBlockInfo(block)

    -- Never mine Stone or Bedrock

    if not info or isBlocked(info) then
        return
    end

    while block.Parent and AutoMine do

        local currentInfo =
            getBlockInfo(block)

        if not currentInfo then
            break
        end

        -- Safety check
        -- If it becomes Stone/Bedrock, immediately stop

        if isBlocked(currentInfo) then
            break
        end

        MiningServiceClient.currentBlock = block

        MiningServiceClient:damageBlock()

        task.wait()

    end

end


------------------------------------------------
-- FIND ORES
------------------------------------------------

local function getOres()

    local ores = {}

    local blocksFolder =
        workspace.Maps.Mining.Blocks

    for _, block in ipairs(blocksFolder:GetChildren()) do

        local info = getBlockInfo(block)

        -- Only add valid ores
        -- Stone and Bedrock are excluded

        if info and not isBlocked(info) then

            table.insert(ores, block)

        end

    end

    return ores

end


------------------------------------------------
-- AUTO MINE LOOP
------------------------------------------------

task.spawn(function()

    while true do

        if AutoMine then

            local ores = getOres()

            if #ores > 0 then

                -- Random valid ore

                local target =
                    ores[math.random(1, #ores)]

                mineBlock(target)

            else

                -- No valid ore available

                task.wait()

            end

        else

            task.wait(0.1)

        end

    end

end)


------------------------------------------------
-- AUTO MINE TOGGLE
------------------------------------------------

local Toggle = Tabs.Main:AddToggle("AutoMine", {
    Title = "Auto Mine Ores",
    Description = "Mines ores only. Never mines Stone or Bedrock.",
    Default = false
})

Toggle:OnChanged(function()

    AutoMine = Options.AutoMine.Value

    if AutoMine then

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Ore-only mining enabled.",
            Duration = 2
        })

    else

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining stopped.",
            Duration = 2
        })

    end

end)


