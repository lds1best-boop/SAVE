local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Flames Auto Rune",
    SubTitle = "by dawid",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local Holder = Player.PlayerGui.Main.Frames.Flames.Holder

local Remote = ReplicatedStorage
    :WaitForChild("Packages")
    :WaitForChild("Packets")
    :WaitForChild("lib")
    :WaitForChild("system")
    :WaitForChild("ByteNetReliable")

-- Collect / roll
local CollectArgs = {
    buffer.fromstring("\n\006\000Flames")
}

-- Runes
local RuneArgs = {
    [1] = {
        buffer.fromstring("\004\001\006\000Flames")
    },

    [2] = {
        buffer.fromstring("\004\002\006\000Flames")
    },

    [3] = {
        buffer.fromstring("\004\003\006\000Flames")
    },

    [4] = {
        buffer.fromstring("\004\004\006\000Flames")
    }
}

-- Required boost for each one
local TargetBoosts = {
    [1] = "x3.5",
    [2] = "x5",
    [3] = "+1.25",
    [4] = "+1"
}

local AutoFlames = false
local InitialCheckComplete = false -- New flag to track if initial check is complete

-- Prevents each rune from firing more than once
local RuneLocked = {
    [1] = false,
    [2] = false,
    [3] = false,
    [4] = false
}

local function ResetLocks()
    for i = 1, 4 do
        RuneLocked[i] = false
    end
    InitialCheckComplete = false -- Reset this flag too
end

local function AllRunesFinished()
    for i = 1, 4 do
        if not RuneLocked[i] then
            return false
        end
    end

    return true
end

local function CheckExistingBoosts()
    -- Check if any runes already have target boosts and lock them
    for i = 1, 4 do
        local Amount = Holder[tostring(i)].Boost.Amount.Text
        if Amount == TargetBoosts[i] then
            RuneLocked[i] = true
            print("Rune " .. i .. " already has target boost: " .. Amount)
        end
    end
    InitialCheckComplete = true
end

local Toggle = Tabs.Main:AddToggle("AutoFlames", {
    Title = "Auto Flames",
    Description = "Stops automatically after all 4 boosts are reached",
    Default = false
})

Toggle:OnChanged(function()
    AutoFlames = Toggle.Value

    if AutoFlames then
        -- Check existing boosts first
        CheckExistingBoosts()
        
        -- If all runes are already locked, stop immediately
        if AllRunesFinished() then
            AutoFlames = false
            Toggle:SetValue(false)
            print("All 4 boosts already reached!")
            print("Auto Flames stopped.")
        else
            print("Auto Flames started")
        end
    else
        print("Auto Flames stopped")
    end
end)

task.spawn(function()
    while true do
        if AutoFlames then
            -- Only start rolling after initial check is complete
            if InitialCheckComplete then
                -- Keep rolling/collecting
                Remote:FireServer(unpack(CollectArgs))

                -- Check every boost
                for i = 1, 4 do
                    if not RuneLocked[i] then
                        local Amount = Holder[tostring(i)].Boost.Amount.Text

                        if Amount == TargetBoosts[i] then
                            -- Lock BEFORE firing
                            RuneLocked[i] = true

                            -- Fire exactly ONE time
                            Remote:FireServer(unpack(RuneArgs[i]))

                            print(
                                "Rune " .. i ..
                                " fired once at " .. Amount
                            )
                        end
                    end
                end

                -- ALL 4 reached their targets
                if AllRunesFinished() then
                    AutoFlames = false
                    Toggle:SetValue(false)

                    print("All 4 boosts reached!")
                    print("Auto Flames stopped.")
                end
            end
        end

        task.wait()
    end
end)

Tabs.Settings:AddButton({
    Title = "Print Current Boosts",
    Description = "Prints all 4 boost values",
    Callback = function()
        for i = 1, 4 do
            print(
                "Flame " .. i .. ":",
                Holder[tostring(i)].Boost.Amount.Text
            )
        end
    end
})

Window:SelectTab(1)
