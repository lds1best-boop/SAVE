--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo


--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


--------------------------------------------------
-- CHECK IF BLOCK IS STONE OR BEDROCK
--------------------------------------------------

local function isBlocked(info)

    if not info then
        return true
    end

    -- StoneOre, StoneOre1, StoneOre2, etc.
    if string.match(info.Id, "^StoneOre%d*$") then
        return true
    end

    -- Bedrock
    if info.Id == "Bedrock" then
        return true
    end

    return false

end


--------------------------------------------------
-- DAMAGE SPECIFIC BLOCK
--------------------------------------------------

local function damageSpecificBlock(blockName)

    if not MiningServiceClient.mineFolder then
        return false
    end

    local block =
        MiningServiceClient.mineFolder:FindFirstChild(blockName)

    if not block then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    local info = getBlockInfo(block)

    -- NEVER damage Stone or Bedrock
    if not info or isBlocked(info) then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end


--------------------------------------------------
-- FIND ONLY ORES
--------------------------------------------------

local function getValidOres()

    local ores = {}

    if not MiningServiceClient.mineFolder then
        return ores
    end

    for _, block in ipairs(
        MiningServiceClient.mineFolder:GetChildren()
    ) do

        if block:GetAttribute("isBlock") then

            local info = getBlockInfo(block)

            if info and not isBlocked(info) then

                table.insert(ores, block)

            end

        end

    end

    return ores

end


--------------------------------------------------
-- AUTO MINE LOOP
--------------------------------------------------

task.spawn(function()

    while true do

        if AutoMine then

            local ores = getValidOres()

            if #ores > 0 then

                local target =
                    ores[math.random(1, #ores)]

                while target.Parent and AutoMine do

                    local info =
                        getBlockInfo(target)

                    if not info then
                        break
                    end

                    -- Safety check:
                    -- NEVER mine Stone or Bedrock
                    if isBlocked(info) then
                        break
                    end

                    damageSpecificBlock(target.Name)

                    task.wait()

                end

            else

                task.wait(0.1)

            end

        else

            task.wait(0.1)

        end

    end

end)


--------------------------------------------------
-- FLUENT TOGGLE
--------------------------------------------------

local Toggle = Tabs.Main:AddToggle("AutoMine", {
    Title = "Auto Mine Ores",
    Description = "Only mines ores. Never mines Stone or Bedrock.",
    Default = false
})

Toggle:OnChanged(function(value)

    AutoMine = value

    print("Auto Mine:", AutoMine)

    if AutoMine then

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Ore-only mining started.",
            Duration = 2
        })

    else

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining stopped.",
            Duration = 2
        })

    end

end)


