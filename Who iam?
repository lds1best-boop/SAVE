    })
}

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksData =
    require(Rs.Shared.Info.MiningInfo.Blocks)

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false

local MIN_DEPTH = -4999

local PATH_X = 9
local PATH_Z = 9

local SelectedOres = {}

--------------------------------------------------
-- DEFAULT SELECTED ORES
--------------------------------------------------

local DefaultSelected = {
    ["Abyssalite"] = true,
    ["Prismite"] = true,
    ["Glitched"] = true,
    ["Luminite"] = true,
    ["Frost"] = true,
    ["Pinky Dreamy"] = true
}

--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end

--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end

    return string.match(
        info.Id,
        "^StoneOre%d*$"
    ) ~= nil

end

--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end

    return info.Id == "Bedrock"

end

--------------------------------------------------
-- ORE
--------------------------------------------------

local function isOre(info)

    if not info then
        return false
    end

    if isStone(info) then
        return false
    end

    if isBedrock(info) then
        return false
    end

    return true

end

--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end

    if not isOre(info) then
        return false
    end

    return SelectedOres[info.Id] == true

end

--------------------------------------------------
-- GET Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end

    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )

    return tonumber(y)

end

--------------------------------------------------
-- DEPTH CHECK
--------------------------------------------------

local function isAllowedDepth(block)

    local y = getBlockY(block)

    if y == nil then
        return false
    end

    return y >= MIN_DEPTH

end

--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if not isAllowedDepth(block) then
        return false
    end

    local info =
        getBlockInfo(block)

    if not info then
        return false
    end

    -- NEVER MINE BEDROCK

    if isBedrock(info) then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end

--------------------------------------------------
-- MINE ANY ORE
-- USED ONLY WHILE GOING DOWN
--------------------------------------------------

local function mineAnyOre(block)

    if not block then
        return
    end

    while block.Parent and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isOre(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end

--------------------------------------------------
-- MINE SELECTED ORE
-- USED AFTER -4999
--------------------------------------------------

local function mineSelectedOre(block)

    if not block then
        return
    end

    while block.Parent and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isSelectedOre(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end

--------------------------------------------------
-- MINE STONE
-- ONLY USED TO GO DOWN
--------------------------------------------------

local function mineStone(block)

    if not block then
        return
    end

    while block.Parent and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isStone(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end

--------------------------------------------------
-- GET BLOCK AT COORDINATE
--------------------------------------------------

local function getBlockAt(x, y, z)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local name =
        tostring(x) ..
        "_" ..
        tostring(y) ..
        "_" ..
        tostring(z)

    return MiningServiceClient.mineFolder:FindFirstChild(name)

end

--------------------------------------------------
-- FIND ANY ORE AT / ABOVE CURRENT DEPTH
--
-- DURING DOWNWARD MINING:
-- ALL ORES ARE ALLOWED
--------------------------------------------------

local function findAnyOre(y)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local ores = {}

    for _, block in ipairs(
        MiningServiceClient.mineFolder:GetChildren()
    ) do

        if block.Parent then

            local blockY =
                getBlockY(block)

            if blockY
                and blockY >= MIN_DEPTH
                and blockY <= y then

                local info =
                    getBlockInfo(block)

                if info and isOre(info) then

                    table.insert(
                        ores,
                        block
                    )

                end

            end

        end

    end

    if #ores > 0 then

        return ores[
            math.random(
                1,
                #ores
            )
        ]

    end

    return nil

end

--------------------------------------------------
-- MINE DOWN TO -4999
--
-- IMPORTANT:
-- ALL ORES ARE MINED HERE
-- SELECTED OR NOT SELECTED
--------------------------------------------------

local function mineDownToBottom()

    for y = 0, MIN_DEPTH, -1 do

        if not AutoMine then
            return false
        end

        --------------------------------------------------
        -- FIRST: ANY ORE
        --------------------------------------------------

        local ore =
            findAnyOre(y)

        if ore then

            mineAnyOre(ore)

        end

        if not AutoMine then
            return false
        end

        --------------------------------------------------
        -- THEN: PATH BLOCK
        --------------------------------------------------

        local pathBlock =
            getBlockAt(
                PATH_X,
                y,
                PATH_Z
            )

        if pathBlock then

            local info =
                getBlockInfo(pathBlock)

            if info then

                --------------------------------------------------
                -- ANY ORE
                --------------------------------------------------

                if isOre(info) then

                    mineAnyOre(
                        pathBlock
                    )

                --------------------------------------------------
                -- STONE
                --------------------------------------------------

                elseif isStone(info) then

                    mineStone(
                        pathBlock
                    )

                --------------------------------------------------
                -- BEDROCK
                --------------------------------------------------

                elseif isBedrock(info) then

                    warn(
                        "Bedrock found at Y = " ..
                        tostring(y) ..
                        ". Stopping downward path."
                    )

                    return false

                end

            end

        end

    end

    return true

end

--------------------------------------------------
-- RANDOM SELECTED ORES
--
-- AFTER -4999
--
-- ONLY SELECTED ORES
--------------------------------------------------

local function randomSelectedOreMining()

    while AutoMine do

        local ores = {}

        if MiningServiceClient.mineFolder then

            for _, block in ipairs(
                MiningServiceClient.mineFolder:GetChildren()
            ) do

                if block.Parent then

                    local y =
                        getBlockY(block)

                    --------------------------------------------------
                    -- NEVER BELOW -4999
                    --------------------------------------------------

                    if y and y >= MIN_DEPTH then

                        local info =
                            getBlockInfo(block)

                        --------------------------------------------------
                        -- SELECTED ORES ONLY
                        --------------------------------------------------

                        if info
                            and isSelectedOre(info) then

                            table.insert(
                                ores,
                                block
                            )

                        end

                    end

                end

            end

        end

        --------------------------------------------------
        -- RANDOM SELECTED ORE
        --------------------------------------------------

        if #ores > 0 then

            local target =
                ores[
                    math.random(
                        1,
                        #ores
                    )
                ]

            mineSelectedOre(target)

        else

            task.wait(0.1)

        end

    end

end

--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining()

    task.spawn(function()

        local reachedBottom =
            mineDownToBottom()

        --------------------------------------------------
        -- AFTER REACHING -4999
        --------------------------------------------------

        if AutoMine and reachedBottom then

            Fluent:Notify({
                Title = "Depth Reached",
                Content = "Reached -4999. Mining selected ores only.",
                Duration = 3
            })

            randomSelectedOreMining()

        end

    end)

end

--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues = {}

local DisplayToId = {}

for id, data in pairs(BlocksData) do

    if id
        and not string.match(
            id,
            "^StoneOre%d*$"
        )
        and id ~= "Bedrock" then

        local displayName = id

        if type(data) == "table" then

            displayName =
                data.name
                or data.Name
                or id

        end

        table.insert(
            OreValues,
            displayName
        )

        DisplayToId[displayName] = id

    end

end

table.sort(OreValues)

--------------------------------------------------
-- DEFAULT SELECTION
--------------------------------------------------

for displayName, enabled in pairs(
    DefaultSelected
) do

    if enabled then

        local id =
            DisplayToId[displayName]

        if id then
            SelectedOres[id] = true
        end

    end

end

--------------------------------------------------
-- CREATE MULTI DROPDOWN
--------------------------------------------------

local DefaultDropdown = {}

for displayName, id in pairs(DisplayToId) do

    if DefaultSelected[displayName] then
        DefaultDropdown[displayName] = true
    end

end

local MultiDropdown =
    Tabs.Main:AddDropdown(
        "OreSelection",
        {
            Title = "Select Ores",
            Description = "Selected ores are mined after -4999.",
            Values = OreValues,
            Multi = true,
            Default = DefaultDropdown
        }
    )

--------------------------------------------------
-- DROPDOWN CHANGED
--------------------------------------------------

MultiDropdown:OnChanged(function(values)

    SelectedOres = {}

    for displayName, enabled in pairs(values) do

        if enabled then

            local id =
                DisplayToId[displayName]

            if id then
                SelectedOres[id] = true
            end

        end

    end

end)

--------------------------------------------------
-- AUTO MINE TOGGLE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {
            Title = "Auto Mine",
            Description = "Mine all ores going down, selected ores at -4999.",
            Default = false
        }
    )

Toggle:OnChanged(function(value)

    AutoMine = value

    if AutoMine then

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining down to -4999...",
            Duration = 2
        })

        startMining()

    else

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining stopped.",
            Duration = 2
        })

    end

end)

