--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksData =
    require(Rs.Shared.Info.MiningInfo.Blocks)


--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false
local MiningRunning = false

local MIN_DEPTH = -4999

local PATH_X = 9
local PATH_Z = 9


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres = {}


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end

    return string.match(
        info.Id,
        "^StoneOre%d*$"
    ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end

    return info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end

    if isStone(info) then
        return false
    end

    if isBedrock(info) then
        return false
    end

    return SelectedOres[info.Id] == true

end


--------------------------------------------------
-- GET Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end

    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )

    return tonumber(y)

end


--------------------------------------------------
-- DEPTH CHECK
--------------------------------------------------

local function isAllowedDepth(block)

    local y = getBlockY(block)

    if y == nil then
        return false
    end

    return y >= MIN_DEPTH

end


--------------------------------------------------
-- GET PATH BLOCK
--------------------------------------------------

local function getBlockAt(x, y, z)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local name =
        tostring(x) ..
        "_" ..
        tostring(y) ..
        "_" ..
        tostring(z)

    return MiningServiceClient.mineFolder:FindFirstChild(name)

end


--------------------------------------------------
-- DAMAGE
--------------------------------------------------

local function damageBlock(block)

    if not block
        or not block.Parent
        or not AutoMine then

        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if not isAllowedDepth(block) then
        return false
    end

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    -- NEVER DAMAGE BEDROCK

    if isBedrock(info) then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end


--------------------------------------------------
-- MINE SELECTED ORE
--------------------------------------------------

local function mineSelectedOre(block)

    if not block then
        return
    end

    while AutoMine
        and block.Parent do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if not isSelectedOre(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end


--------------------------------------------------
-- MINE STONE FOR PATH
--------------------------------------------------

local function mineStone(block)

    if not block then
        return
    end

    while AutoMine
        and block.Parent do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isStone(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end


--------------------------------------------------
-- MINE CURRENT PATH BLOCK
--------------------------------------------------

local function processPathBlock(y)

    local block =
        getBlockAt(
            PATH_X,
            y,
            PATH_Z
        )

    if not block then
        return
    end

    local info =
        getBlockInfo(block)

    if not info then
        return
    end

    --------------------------------------------------
    -- SELECTED ORE FIRST
    --------------------------------------------------

    if isSelectedOre(info) then

        mineSelectedOre(block)

        return

    end


    --------------------------------------------------
    -- STONE ONLY TO GO DOWN
    --------------------------------------------------

    if isStone(info) then

        mineStone(block)

        return

    end


    --------------------------------------------------
    -- NEVER MINE BEDROCK
    --------------------------------------------------

    if isBedrock(info) then
        return
    end

end


--------------------------------------------------
-- DOWNWARD PATH
--------------------------------------------------

local function mineDown()

    for y = 0, MIN_DEPTH, -1 do

        if not AutoMine then
            return false
        end

        processPathBlock(y)

        -- Give the client time to process
        task.wait()

    end

    return true

end


--------------------------------------------------
-- FIND RANDOM SELECTED ORE
--
-- IMPORTANT:
-- This does NOT repeatedly scan the entire
-- folder every depth.
--------------------------------------------------

local function findRandomSelectedOre()

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local ores = {}

    local children =
        MiningServiceClient.mineFolder:GetChildren()

    --------------------------------------------------
    -- Scan current blocks ONCE
    --------------------------------------------------

    for i, block in ipairs(children) do

        if not AutoMine then
            return nil
        end

        if block.Parent then

            local y =
                getBlockY(block)

            if y and y >= MIN_DEPTH then

                local info =
                    getBlockInfo(block)

                if info
                    and isSelectedOre(info) then

                    table.insert(
                        ores,
                        block
                    )

                end

            end

        end

        --------------------------------------------------
        -- Yield every 100 blocks
        --------------------------------------------------

        if i % 100 == 0 then
            task.wait()
        end

    end


    if #ores == 0 then
        return nil
    end

    return ores[
        math.random(
            1,
            #ores
        )
    ]

end


--------------------------------------------------
-- RANDOM ORE MINING
--------------------------------------------------

local function randomOreMining()

    while AutoMine do

        local target =
            findRandomSelectedOre()

        if target then

            mineSelectedOre(target)

        else

            -- Nothing available right now
            task.wait(0.25)

        end

        --------------------------------------------------
        -- Small yield prevents client lockup
        --------------------------------------------------

        task.wait(0.05)

    end

end


--------------------------------------------------
-- MAIN MINING THREAD
--------------------------------------------------

local function startMining()

    if MiningRunning then
        return
    end

    MiningRunning = true

    task.spawn(function()

        --------------------------------------------------
        -- FIRST GO DOWN TO -4999
        --------------------------------------------------

        local reachedBottom =
            mineDown()

        --------------------------------------------------
        -- THEN RANDOM ORES
        --------------------------------------------------

        if reachedBottom
            and AutoMine then

            randomOreMining()

        end

        MiningRunning = false

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues = {}

local OreMap = {}

for id, data in pairs(BlocksData) do

    if id
        and not string.match(
            id,
            "^StoneOre%d*$"
        )
        and id ~= "Bedrock" then

        local displayName = id

        if type(data) == "table" then

            displayName =
                data.name
                or data.Name
                or id

        end

        table.insert(
            OreValues,
            displayName
        )

        OreMap[displayName] = id

    end

end

table.sort(OreValues)


--------------------------------------------------
-- ORE DROPDOWN
--------------------------------------------------

local MultiDropdown =
    Tabs.Main:AddDropdown(
        "OreSelection",
        {
            Title = "Select Ores",
            Description = "Choose which ores to mine.",
            Values = OreValues,
            Multi = true,
            Default = {}
        }
    )


--------------------------------------------------
-- DROPDOWN CHANGED
--------------------------------------------------

MultiDropdown:OnChanged(function(values)

    SelectedOres = {}

    for displayName, enabled in pairs(values) do

        if enabled then

            local id =
                OreMap[displayName]

            if id then
                SelectedOres[id] = true
            end

        end

    end

end)


--------------------------------------------------
-- AUTO MINE TOGGLE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {
            Title = "Auto Mine",
            Description = "Mine selected ores to -4999.",
            Default = false
        }
    )


Toggle:OnChanged(function(value)

    AutoMine = value

    if AutoMine then

        if next(SelectedOres) == nil then

            AutoMine = false

            Toggle:SetValue(false)

            Fluent:Notify({
                Title = "Auto Mine",
                Content = "Select at least one ore first.",
                Duration = 3
            })

            return

        end

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining down to -4999...",
            Duration = 2
        })

        startMining()

    else

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining stopped.",
            Duration = 2
        })

    end

end)


