--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo


--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false

local MIN_DEPTH = -4999

local PATH_X = 9
local PATH_Z = 9


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


--------------------------------------------------
-- BLOCK TYPES
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end

    return info.Id == "Bedrock"
end


local function isStone(info)

    if not info then
        return false
    end

    return string.match(info.Id, "^StoneOre%d*$") ~= nil
end


local function isOre(info)

    if not info then
        return false
    end

    if isBedrock(info) then
        return false
    end

    if isStone(info) then
        return false
    end

    return true
end


--------------------------------------------------
-- GET Y FROM BLOCK NAME
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end

    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )

    return tonumber(y)

end


--------------------------------------------------
-- CHECK DEPTH
--------------------------------------------------

local function isAllowedDepth(block)

    local y = getBlockY(block)

    if y == nil then
        return false
    end

    return y >= MIN_DEPTH
end


--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if not isAllowedDepth(block) then
        return false
    end

    local info =
        getBlockInfo(block)

    if not info then
        return false
    end

    if isBedrock(info) then
        return false
    end

    MiningServiceClient.currentBlock = block

    MiningServiceClient:damageBlock()

    return true

end


--------------------------------------------------
-- MINE BLOCK UNTIL DESTROYED
--------------------------------------------------

local function mineUntilGone(block, allowedType)

    if not block then
        return false
    end

    while block.Parent and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isAllowedDepth(block) then
            break
        end

        ------------------------------------------------
        -- ORE MODE
        ------------------------------------------------

        if allowedType == "ORE" then

            if not isOre(info) then
                break
            end

        ------------------------------------------------
        -- STONE MODE
        ------------------------------------------------

        elseif allowedType == "STONE" then

            if not isStone(info) then
                break
            end

        ------------------------------------------------
        -- ANY MODE
        ------------------------------------------------

        elseif allowedType == "ANY" then

            -- Ore or Stone allowed
            if not isOre(info)
                and not isStone(info) then
                break
            end

        end

        damageBlock(block)

        task.wait()

    end

    return true

end


--------------------------------------------------
-- GET BLOCK AT COORDINATE
--------------------------------------------------

local function getBlockAt(x, y, z)

    local name =
        tostring(x) ..
        "_" ..
        tostring(y) ..
        "_" ..
        tostring(z)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    return MiningServiceClient.mineFolder:FindFirstChild(name)

end


--------------------------------------------------
-- FIND ORE NEAR CURRENT DEPTH
--------------------------------------------------

local function findOreAtDepth(y)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local ores = {}

    for _, block in ipairs(
        MiningServiceClient.mineFolder:GetChildren()
    ) do

        if block.Parent then

            local blockY =
                getBlockY(block)

            if blockY
                and blockY >= MIN_DEPTH
                and blockY <= y then

                local info =
                    getBlockInfo(block)

                if info and isOre(info) then

                    table.insert(ores, block)

                end

            end

        end

    end

    if #ores > 0 then

        return ores[
            math.random(1, #ores)
        ]

    end

    return nil

end


--------------------------------------------------
-- DOWNWARD MINING
--
-- ORE FIRST
-- STONE SECOND
--------------------------------------------------

local function mineDownToBottom()

    for y = 0, MIN_DEPTH, -1 do

        if not AutoMine then
            return
        end

        ------------------------------------------------
        -- FIRST: LOOK FOR AN ORE AT THIS DEPTH
        ------------------------------------------------

        local ore =
            findOreAtDepth(y)

        if ore then

            mineUntilGone(
                ore,
                "ORE"
            )

        end


        if not AutoMine then
            return
        end


        ------------------------------------------------
        -- SECOND: MINE THE PATH BLOCK
        ------------------------------------------------

        local pathBlock =
            getBlockAt(
                PATH_X,
                y,
                PATH_Z
            )

        if pathBlock then

            local info =
                getBlockInfo(pathBlock)

            if info then

                ------------------------------------------------
                -- ORE AT PATH = MINE ORE
                ------------------------------------------------

                if isOre(info) then

                    mineUntilGone(
                        pathBlock,
                        "ORE"
                    )

                ------------------------------------------------
                -- STONE = MINE STONE TO GO DOWN
                ------------------------------------------------

                elseif isStone(info) then

                    mineUntilGone(
                        pathBlock,
                        "STONE"
                    )

                ------------------------------------------------
                -- BEDROCK = NEVER MINE
                ------------------------------------------------

                elseif isBedrock(info) then

                    warn(
                        "Bedrock found at " ..
                        tostring(y) ..
                        ". Not mining it."
                    )

                    return

                end

            end

        end

    end

end


--------------------------------------------------
-- RANDOM ORE MINING
--
-- AFTER REACHING -4999
--------------------------------------------------

local function randomOreMining()

    while AutoMine do

        local ores = {}

        if MiningServiceClient.mineFolder then

            for _, block in ipairs(
                MiningServiceClient.mineFolder:GetChildren()
            ) do

                if block.Parent then

                    local y =
                        getBlockY(block)

                    ------------------------------------------------
                    -- ONLY -4999 OR ABOVE
                    ------------------------------------------------

                    if y and y >= MIN_DEPTH then

                        local info =
                            getBlockInfo(block)

                        ------------------------------------------------
                        -- ORE ONLY
                        ------------------------------------------------

                        if info and isOre(info) then

                            table.insert(
                                ores,
                                block
                            )

                        end

                    end

                end

            end

        end


        ------------------------------------------------
        -- RANDOM ORE
        ------------------------------------------------

        if #ores > 0 then

            local target =
                ores[
                    math.random(
                        1,
                        #ores
                    )
                ]

            mineUntilGone(
                target,
                "ORE"
            )

        else

            task.wait(0.1)

        end

    end

end


--------------------------------------------------
-- MAIN AUTO MINE
--------------------------------------------------

local function startMining()

    task.spawn(function()

        mineDownToBottom()

        ------------------------------------------------
        -- WHEN -4999 IS REACHED:
        -- RANDOM ORE ONLY
        ------------------------------------------------

        if AutoMine then

            randomOreMining()

        end

    end)

end


--------------------------------------------------
-- FLUENT TOGGLE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {
            Title = "Auto Mine Ores",
            Description = "Mine to -4999, then randomly mine ores.",
            Default = false
        }
    )


Toggle:OnChanged(function(value)

    AutoMine = value

    if AutoMine then

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining to -4999...",
            Duration = 2
        })

        startMining()

    else

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining stopped.",
            Duration = 2
        })

    end

end)


