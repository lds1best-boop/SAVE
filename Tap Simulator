local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Flames Auto Rune",
    SubTitle = "by dawid",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local Holder = Player.PlayerGui.Main.Frames.Flames.Holder

local Remote = ReplicatedStorage
    :WaitForChild("Packages")
    :WaitForChild("Packets")
    :WaitForChild("lib")
    :WaitForChild("system")
    :WaitForChild("ByteNetReliable")

-- Roll / collect
local CollectArgs = {
    buffer.fromstring("\n\006\000Flames")
}

-- Rune remotes
local RuneArgs = {
    [1] = {
        buffer.fromstring("\004\001\006\000Flames")
    },

    [2] = {
        buffer.fromstring("\004\002\006\000Flames")
    },

    [3] = {
        buffer.fromstring("\004\003\006\000Flames")
    },

    [4] = {
        buffer.fromstring("\004\004\006\000Flames")
    }
}

-- Required boost values
local TargetBoosts = {
    [1] = "x3.5",
    [2] = "x5",
    [3] = "+1.25",
    [4] = "+1"
}

local AutoFlames = false
local Starting = false

-- Locked = target already reached and rune has fired
local RuneLocked = {
    [1] = false,
    [2] = false,
    [3] = false,
    [4] = false
}

local function ResetLocks()
    for i = 1, 4 do
        RuneLocked[i] = false
    end
end

local function CheckBoosts()
    for i = 1, 4 do
        if not RuneLocked[i] then
            local Amount = Holder[tostring(i)].Boost.Amount.Text

            if Amount == TargetBoosts[i] then
                RuneLocked[i] = true

                -- Fire this rune exactly once
                Remote:FireServer(unpack(RuneArgs[i]))

                print("Rune " .. i .. " locked at " .. Amount)
            end
        end
    end
end

local function AllLocked()
    for i = 1, 4 do
        if not RuneLocked[i] then
            return false
        end
    end

    return true
end

local Toggle = Tabs.Main:AddToggle("AutoFlames", {
    Title = "Auto Flames",
    Description = "Check boosts first, then roll",
    Default = false
})

Toggle:OnChanged(function()
    AutoFlames = Toggle.Value

    if AutoFlames then
        ResetLocks()
        Starting = true

        print("Checking boosts before rolling...")

        -- FIRST: check current boosts BEFORE any rolling
        CheckBoosts()

        -- If everything is already complete, don't roll
        if AllLocked() then
            Starting = false
            AutoFlames = false
            Toggle:SetValue(false)

            print("All boosts already reached. Nothing to roll.")
            return
        end

        -- Wait 2 seconds before starting roll
        task.spawn(function()
            task.wait(2)

            if AutoFlames then
                Starting = false
                print("2 seconds finished. Starting roll...")
            else
                Starting = false
            end
        end)

    else
        Starting = false
        ResetLocks()

        print("Auto Flames stopped.")
    end
end)

task.spawn(function()
    while true do

        if AutoFlames and not Starting then

            -- Keep checking boosts
            CheckBoosts()

            -- If all 4 reached target, stop rolling
            if AllLocked() then
                AutoFlames = false
                Toggle:SetValue(false)

                print("All 4 boosts reached!")
                print("Roll stopped.")

            else
                -- Roll only if there are still boosts to reach
                Remote:FireServer(unpack(CollectArgs))
            end
        end

        -- Continuous checking
        task.wait()
    end
end)

Tabs.Settings:AddButton({
    Title = "Print Current Boosts",
    Description = "lol",
    Callback = function()
        for i = 1, 4 do
            print(
                "Flame " .. i .. ":",
                Holder[tostring(i)].Boost.Amount.Text
            )
        end
    end
})

Window:SelectTab(1)
