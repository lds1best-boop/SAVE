--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksData =
    require(Rs.Shared.Info.MiningInfo.Blocks)


--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false

local MIN_DEPTH = -4999

-- DOWNWARD LINE
local PATH_X = 9
local PATH_Z = 9

local SelectedOres = {}


--------------------------------------------------
-- DEFAULT SELECTED ORES
--------------------------------------------------

local DefaultSelected = {
    ["Abyssalite"] = true,
    ["Prismite"] = true,
    ["Glitched"] = true,
    ["Luminite"] = true,
    ["Frost"] = true,
    ["Pinky Dreamy"] = true
}


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


--------------------------------------------------
-- STONE CHECK
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end

    return string.match(
        info.Id,
        "^StoneOre%d*$"
    ) ~= nil

end


--------------------------------------------------
-- BEDROCK CHECK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end

    return info.Id == "Bedrock"

end


--------------------------------------------------
-- ORE CHECK
--------------------------------------------------

local function isOre(info)

    if not info then
        return false
    end

    if isStone(info) then
        return false
    end

    if isBedrock(info) then
        return false
    end

    return true

end


--------------------------------------------------
-- SELECTED ORE CHECK
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end

    if not isOre(info) then
        return false
    end

    return SelectedOres[info.Id] == true

end


--------------------------------------------------
-- GET Y FROM BLOCK NAME
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end

    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )

    return tonumber(y)

end


--------------------------------------------------
-- DEPTH CHECK
--------------------------------------------------

local function isAllowedDepth(block)

    local y =
        getBlockY(block)

    if y == nil then
        return false
    end

    return y >= MIN_DEPTH

end


--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if not isAllowedDepth(block) then
        return false
    end

    local info =
        getBlockInfo(block)

    if not info then
        return false
    end

    -- NEVER MINE BEDROCK

    if isBedrock(info) then
        return false
    end

    MiningServiceClient.currentBlock = block

    MiningServiceClient:damageBlock()

    return true

end


--------------------------------------------------
-- MINE ANY ORE
--
-- USED ONLY WHILE GOING DOWN
--------------------------------------------------

local function mineAnyOre(block)

    if not block then
        return
    end

    while block.Parent
        and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isOre(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end


--------------------------------------------------
-- MINE SELECTED ORE
--
-- USED AFTER -4999
--------------------------------------------------

local function mineSelectedOre(block)

    if not block then
        return
    end

    while block.Parent
        and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isSelectedOre(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end


--------------------------------------------------
-- MINE STONE
--
-- ONLY USED WHILE GOING DOWN
--------------------------------------------------

local function mineStone(block)

    if not block then
        return
    end

    while block.Parent
        and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isStone(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end


--------------------------------------------------
-- GET BLOCK AT COORDINATE
--------------------------------------------------

local function getBlockAt(x, y, z)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local name =
        tostring(x) ..
        "_" ..
        tostring(y) ..
        "_" ..
        tostring(z)

    return MiningServiceClient.mineFolder:FindFirstChild(name)

end


--------------------------------------------------
-- GO DOWN
--
-- IMPORTANT:
-- ONLY CHECKS:
--
-- 9_0_9
-- 9_-1_9
-- 9_-2_9
-- ...
-- 9_-4999_9
--
-- NO SEARCH AROUND THE MAP
--------------------------------------------------

local function mineDownToBottom()

    for y = 0, MIN_DEPTH, -1 do

        if not AutoMine then
            return false
        end


        --------------------------------------------------
        -- ONLY THE CURRENT LINE BLOCK
        --------------------------------------------------

        local pathBlock =
            getBlockAt(
                PATH_X,
                y,
                PATH_Z
            )


        if pathBlock then

            local info =
                getBlockInfo(pathBlock)

            if info then


                --------------------------------------------------
                -- ANY ORE
                --
                -- SELECTED OR NOT SELECTED
                --------------------------------------------------

                if isOre(info) then

                    mineAnyOre(
                        pathBlock
                    )


                --------------------------------------------------
                -- STONE
                --
                -- ONLY TO KEEP GOING DOWN
                --------------------------------------------------

                elseif isStone(info) then

                    mineStone(
                        pathBlock
                    )


                --------------------------------------------------
                -- BEDROCK
                --
                -- NEVER MINE
                --------------------------------------------------

                elseif isBedrock(info) then

                    warn(
                        "Bedrock found at Y = "
                        .. tostring(y)
                        .. ". Not mining."
                    )

                    return false

                end

            end

        end

    end

    return true

end


--------------------------------------------------
-- RANDOM SELECTED ORE MINING
--
-- ONLY AFTER -4999
--------------------------------------------------

local function randomSelectedOreMining()

    while AutoMine do

        local ores = {}


        if MiningServiceClient.mineFolder then

            for _, block in ipairs(
                MiningServiceClient.mineFolder:GetChildren()
            ) do

                if block.Parent then

                    local y =
                        getBlockY(block)


                    --------------------------------------------------
                    -- NEVER GO BELOW -4999
                    --------------------------------------------------

                    if y
                        and y >= MIN_DEPTH then

                        local info =
                            getBlockInfo(block)


                        --------------------------------------------------
                        -- ONLY SELECTED ORES
                        --------------------------------------------------

                        if info
                            and isSelectedOre(info) then

                            table.insert(
                                ores,
                                block
                            )

                        end

                    end

                end

            end

        end


        --------------------------------------------------
        -- RANDOM SELECTED ORE
        --------------------------------------------------

        if #ores > 0 then

            local target =
                ores[
                    math.random(
                        1,
                        #ores
                    )
                ]


            mineSelectedOre(
                target
            )

        else

            task.wait(0.1)

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining()

    task.spawn(function()


        --------------------------------------------------
        -- FIRST GO DOWN
        --------------------------------------------------

        local reachedBottom =
            mineDownToBottom()


        --------------------------------------------------
        -- THEN RANDOM SELECTED ORES
        --------------------------------------------------

        if AutoMine
            and reachedBottom then

            Fluent:Notify({
                Title = "Depth Reached",
                Content = "Reached -4999. Selected ores only.",
                Duration = 3
            })

            randomSelectedOreMining()

        end

    end)

end


--------------------------------------------------
-- BUILD ORE DROPDOWN
--------------------------------------------------

local OreValues = {}

local DisplayToId = {}


for id, data in pairs(
    BlocksData
) do

    if id
        and not string.match(
            id,
            "^StoneOre%d*$"
        )
        and id ~= "Bedrock" then


        local displayName = id


        if type(data) == "table" then

            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )


        DisplayToId[displayName] = id

    end

end


table.sort(OreValues)


--------------------------------------------------
-- SET DEFAULT ORES
--------------------------------------------------

for displayName, enabled in pairs(
    DefaultSelected
) do

    if enabled then

        local id =
            DisplayToId[displayName]

        if id then

            SelectedOres[id] = true

        end

    end

end


--------------------------------------------------
-- DEFAULT DROPDOWN VALUES
--------------------------------------------------

local DefaultDropdown = {}


for displayName in pairs(
    DefaultSelected
) do

    if DisplayToId[displayName] then

        DefaultDropdown[displayName] = true

    end

end


--------------------------------------------------
-- ORE MULTI DROPDOWN
--------------------------------------------------

local MultiDropdown =
    Tabs.Main:AddDropdown(
        "OreSelection",
        {
            Title = "Select Ores",

            Description =
                "Going down mines any ore. At -4999 only selected ores.",

            Values = OreValues,

            Multi = true,

            Default = DefaultDropdown
        }
    )


--------------------------------------------------
-- DROPDOWN CHANGED
--------------------------------------------------

MultiDropdown:OnChanged(function(values)

    SelectedOres = {}


    for displayName, enabled in pairs(values) do

        if enabled then

            local id =
                DisplayToId[displayName]

            if id then

                SelectedOres[id] = true

            end

        end

    end

end)


--------------------------------------------------
-- AUTO MINE TOGGLE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {
            Title = "Auto Mine",

            Description =
                "Go to -4999, then mine selected ores.",

            Default = false
        }
    )


Toggle:OnChanged(function(value)

    AutoMine = value


    if AutoMine then

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Starting downward path...",
            Duration = 2
        })


        startMining()

    else

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining stopped.",
            Duration = 2
        })

    end

end)


