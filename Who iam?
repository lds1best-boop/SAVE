local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Fluent " .. Fluent.Version,
    SubTitle = "Ore Miner",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({
        Title = "Main",
        Icon = ""
    }),

    Settings = Window:AddTab({
        Title = "Settings",
        Icon = "settings"
    })
}


--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Rs = cloneref(game:GetService("ReplicatedStorage"))

local MiningServiceClient =
    require(Rs.Shared.Services.MiningService.MiningServiceClient)

local MiningInfo =
    require(Rs.Packages.Info).MiningInfo

local BlocksData =
    require(Rs.Shared.Info.MiningInfo.Blocks)


--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false

local MIN_DEPTH = -4999

local PATH_X = 9
local PATH_Z = 9


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if not blockId or blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end

    return string.match(
        info.Id,
        "^StoneOre%d*$"
    ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end

    return info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE CHECK
--------------------------------------------------

local SelectedOres = {}


local function isSelectedOre(info)

    if not info then
        return false
    end

    if isStone(info) then
        return false
    end

    if isBedrock(info) then
        return false
    end

    return SelectedOres[info.Id] == true

end


--------------------------------------------------
-- GET Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end

    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )

    return tonumber(y)

end


--------------------------------------------------
-- DEPTH CHECK
--------------------------------------------------

local function isAllowedDepth(block)

    local y = getBlockY(block)

    if y == nil then
        return false
    end

    return y >= MIN_DEPTH

end


--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageBlock(block)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    if not isAllowedDepth(block) then
        return false
    end

    local info =
        getBlockInfo(block)

    if not info then
        return false
    end

    -- NEVER mine Bedrock

    if isBedrock(info) then
        return false
    end

    MiningServiceClient.currentBlock = block

    MiningServiceClient:damageBlock()

    return true

end


--------------------------------------------------
-- MINE SELECTED ORE
--------------------------------------------------

local function mineSelectedOre(block)

    if not block then
        return
    end

    while block.Parent and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isSelectedOre(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end


--------------------------------------------------
-- MINE STONE
--------------------------------------------------

local function mineStone(block)

    if not block then
        return
    end

    while block.Parent and AutoMine do

        local info =
            getBlockInfo(block)

        if not info then
            break
        end

        if isBedrock(info) then
            break
        end

        if not isStone(info) then
            break
        end

        damageBlock(block)

        task.wait()

    end

end


--------------------------------------------------
-- GET BLOCK AT COORDINATE
--------------------------------------------------

local function getBlockAt(x, y, z)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local name =
        tostring(x) ..
        "_" ..
        tostring(y) ..
        "_" ..
        tostring(z)

    return MiningServiceClient.mineFolder:FindFirstChild(name)

end


--------------------------------------------------
-- FIND SELECTED ORE
--------------------------------------------------

local function findSelectedOre(y)

    if not MiningServiceClient.mineFolder then
        return nil
    end

    local ores = {}

    for _, block in ipairs(
        MiningServiceClient.mineFolder:GetChildren()
    ) do

        if block.Parent then

            local blockY =
                getBlockY(block)

            if blockY
                and blockY >= MIN_DEPTH
                and blockY <= y then

                local info =
                    getBlockInfo(block)

                if info
                    and isSelectedOre(info) then

                    table.insert(
                        ores,
                        block
                    )

                end

            end

        end

    end

    if #ores > 0 then

        return ores[
            math.random(
                1,
                #ores
            )
        ]

    end

    return nil

end


--------------------------------------------------
-- MINE DOWN TO -4999
--------------------------------------------------

local function mineDownToBottom()

    for y = 0, MIN_DEPTH, -1 do

        if not AutoMine then
            return
        end


        --------------------------------------------------
        -- SELECTED ORE FIRST
        --------------------------------------------------

        local ore =
            findSelectedOre(y)

        if ore then

            mineSelectedOre(ore)

        end


        if not AutoMine then
            return
        end


        --------------------------------------------------
        -- PATH BLOCK
        --------------------------------------------------

        local pathBlock =
            getBlockAt(
                PATH_X,
                y,
                PATH_Z
            )

        if pathBlock then

            local info =
                getBlockInfo(pathBlock)

            if info then

                --------------------------------------------------
                -- SELECTED ORE
                --------------------------------------------------

                if isSelectedOre(info) then

                    mineSelectedOre(
                        pathBlock
                    )

                --------------------------------------------------
                -- STONE
                --------------------------------------------------

                elseif isStone(info) then

                    mineStone(
                        pathBlock
                    )

                --------------------------------------------------
                -- BEDROCK
                --------------------------------------------------

                elseif isBedrock(info) then

                    return

                end

            end

        end

    end

end


--------------------------------------------------
-- RANDOM SELECTED ORES
--------------------------------------------------

local function randomOreMining()

    while AutoMine do

        local ores = {}

        if MiningServiceClient.mineFolder then

            for _, block in ipairs(
                MiningServiceClient.mineFolder:GetChildren()
            ) do

                if block.Parent then

                    local y =
                        getBlockY(block)

                    if y and y >= MIN_DEPTH then

                        local info =
                            getBlockInfo(block)

                        if info
                            and isSelectedOre(info) then

                            table.insert(
                                ores,
                                block
                            )

                        end

                    end

                end

            end

        end


        if #ores > 0 then

            local target =
                ores[
                    math.random(
                        1,
                        #ores
                    )
                ]

            mineSelectedOre(
                target
            )

        else

            task.wait(0.1)

        end

    end

end


--------------------------------------------------
-- START
--------------------------------------------------

local function startMining()

    task.spawn(function()

        mineDownToBottom()

        if AutoMine then
            randomOreMining()
        end

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues = {}

for id, data in pairs(BlocksData) do

    if id
        and not string.match(id, "^StoneOre%d*$")
        and id ~= "Bedrock" then

        local displayName = id

        if type(data) == "table" then

            displayName =
                data.name
                or data.Name
                or id

        end

        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(OreValues)


--------------------------------------------------
-- CREATE DROPDOWN
--------------------------------------------------

local MultiDropdown =
    Tabs.Main:AddDropdown(
        "OreSelection",
        {
            Title = "Select Ores",
            Description = "Choose which ores to mine.",
            Values = OreValues,
            Multi = true,
            Default = {}
        }
    )


--------------------------------------------------
-- UPDATE SELECTED ORES
--------------------------------------------------

MultiDropdown:OnChanged(function(values)

    SelectedOres = {}

    for name, enabled in pairs(values) do

        if enabled then

            -- Try to find matching ID
            for id, data in pairs(BlocksData) do

                local displayName = id

                if type(data) == "table" then

                    displayName =
                        data.name
                        or data.Name
                        or id

                end

                if displayName == name then

                    SelectedOres[id] = true

                    break

                end

            end

        end

    end

end)


--------------------------------------------------
-- AUTO MINE TOGGLE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {
            Title = "Auto Mine",
            Description = "Mine selected ores to -4999.",
            Default = false
        }
    )


Toggle:OnChanged(function(value)

    AutoMine = value

    if AutoMine then

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining selected ores to -4999.",
            Duration = 2
        })

        startMining()

    else

        Fluent:Notify({
            Title = "Auto Mine",
            Content = "Mining stopped.",
            Duration = 2
        })

    end

end)


